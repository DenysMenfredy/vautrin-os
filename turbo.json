{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_MIGRATION_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "TRUSTED_ORIGINS",
    "TRUST_PROXY",
    "OPENAI_API_KEY",
    "GOOGLE_OAUTH_CLIENT_ID",
    "GOOGLE_OAUTH_CLIENT_SECRET",
    "GOOGLE_OAUTH_REDIRECT_URI",
    "GCP_PROJECT_ID",
    "LOCAL_SECRET_DIRECTORY",
    "LOCAL_SECRET_ENCRYPTION_KEY",
    "REDIS_TLS_CA_BASE64",
    "VAUTRIN_*",
    "SMOKE_OWNER_EMAIL",
    "SMOKE_OWNER_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".nuxt/**", ".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "../../biome.jsonc"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"]
    },
    "test:integration": {
      "dependsOn": ["^build", "generate"],
      "passThroughEnv": ["JWT_SECRET"],
      "cache": false
    },
    "generate": {
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build", "generate"],
      "passThroughEnv": ["JWT_SECRET"],
      "cache": false
    }
  }
}
