{
  "name": "@vautrin/api",
  "version": "0.1.0",
  "private": true,
  "description": "Vautrin OS HTTP API — NestJS modular monolith (VOS-004, ADR-002)",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "node dist/main.js",
    "onboard:tenant": "dotenv -e ../../.env -- node dist/onboard-tenant.js",
    "seed:samples": "dotenv -e ../../.env -- node seed/seed-samples.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@vautrin/auth": "workspace:*",
    "@vautrin/config": "workspace:*",
    "@vautrin/contracts": "workspace:*",
    "@vautrin/database": "workspace:*",
    "@vautrin/integrations": "workspace:^",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.3",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.2",
    "@vautrin/testing": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "twilio": "^5.4.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "4.1.11"
  },
  "type": "module",
  "files": [
    "dist"
  ]
}
