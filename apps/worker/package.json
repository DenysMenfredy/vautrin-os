{
  "name": "@vautrin/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vautrin OS asynchronous worker \u2014 BullMQ processors (VOS-005, ADR-009)",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@vautrin/config": "workspace:*",
    "@vautrin/contracts": "workspace:*",
    "@vautrin/database": "workspace:*",
    "@vautrin/queues": "workspace:*",
    "bullmq": "^6.3.8",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.3",
    "@types/node": "^26.6.2",
    "@vautrin/testing": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.3",
    "vitest": "4.1.11"
  },
  "files": [
    "dist"
  ]
