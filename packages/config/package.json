{
  "name": "@vautrin/config",
  "version": "0.1.0",
  "private": true,
  "description": "Validated environment configuration shared by Vautrin OS applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vautrin/testing": "workspace:*",
    "typescript": "^5.7.2",
    "vite": "^8.3.3",
    "vitest": "4.1.11"
  }
}
