// ===========================================================================
// Vautrin OS — data layer (VOS-011)
//
// Source of truth for this file:
//   SDD-03 (domain model)  SDD-04 (database)  SDD-05 (multi-tenancy)
//   ADR-003 (pooled multi-tenancy)  ADR-004 (PostgreSQL + pgvector)
//   ADR-005 (RLS)
//
// Table set is exactly the list in SDD-04 §3. Do not add tables here without
// updating SDD-04 first (README "Source of truth").
//
// Conventions
//   - Models are PascalCase, tables and columns are snake_case via @@map/@map.
//   - IDs are UUIDv7 (SDD-04 §5), generated by the `uuidv7()` SQL function
//     installed in the first migration. Time-ordered IDs keep index locality.
//   - Tenant-scoped tables carry `tenant_id` and are protected by RLS.
//   - Every tenant-scoped index starts with tenant_id (SDD-04 §6).
// ===========================================================================

generator client {
  provider = "prisma-client-js"
  // Generated into the package rather than into node_modules.
  //
  // This makes the client an ordinary build artifact shipped through the
  // package's `files`, so `pnpm deploy` produces a self-contained runtime
  // tree with no generate step at deploy time. It also matches the direction
  // Prisma is moving: an explicit output becomes mandatory in Prisma 7.
  output = "../generated/client"
}

datasource db {
  provider = "postgresql"
  // Runtime: least-privileged role, subject to RLS.
  url = env("DATABASE_URL")
  // Migrations: schema-owning role. Never serves application traffic.
  directUrl = env("DATABASE_MIGRATION_URL")
}

// ---------------------------------------------------------------------------
// Enums
//
// Postgres enums are used for values the *platform* owns. Values a tenant may
// extend belong in tables (lead_sources) or JSONB configuration instead.
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION

  @@map("tenant_status")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED

  @@map("user_status")
}

/// ADR-011 §Decision — initial roles.
enum TenantRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  READ_ONLY

  @@map("tenant_role")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REVOKED

  @@map("membership_status")
}

/// SDD-01 §4. Extending this set is a migration + ADR decision, not a runtime
/// change; per-vertical labelling is handled by templates, not by new values.
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  APPOINTMENT_BOOKED
  ESTIMATE_PENDING
  ESTIMATE_SENT
  FOLLOW_UP
  WON
  LOST

  @@map("lead_status")
}

/// SDD-08 §6 — channels the integration layer is designed to carry.
enum Channel {
  SMS
  EMAIL
  VOICE
  WHATSAPP
  WEB

  @@map("channel")
}

enum ConversationStatus {
  OPEN
  PENDING
  SNOOZED
  CLOSED

  @@map("conversation_status")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@map("message_direction")
}

/// FR-007 — message delivery lifecycle.
enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED

  @@map("message_status")
}

enum CallDirection {
  INBOUND
  OUTBOUND

  @@map("call_direction")
}

/// MISSED backs the `call.missed` workflow trigger (SDD-07 §3).
enum CallStatus {
  INITIATED
  RINGING
  IN_PROGRESS
  ANSWERED
  MISSED
  VOICEMAIL
  COMPLETED
  FAILED

  @@map("call_status")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

/// FR-010 — estimate lifecycle including follow-up state.
enum EstimateStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED

  @@map("estimate_status")
}

/// SDD-07 §10 — published versions are immutable.
enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("workflow_status")
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED

  @@map("workflow_run_status")
}

enum StepRunStatus {
  PENDING
  SCHEDULED
  RUNNING
  COMPLETED
  SKIPPED
  FAILED
  AWAITING_APPROVAL

  @@map("step_run_status")
}

/// SDD-07 §4 — V0.1 step types.
enum WorkflowStepType {
  WAIT
  CONDITION
  SEND_MESSAGE
  CREATE_LEAD
  UPDATE_LEAD
  CREATE_APPOINTMENT
  CALL_AGENT
  CREATE_TASK
  HUMAN_APPROVAL
  END

  @@map("workflow_step_type")
}

enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("agent_status")
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
  HANDED_OFF

  @@map("agent_run_status")
}

/// SDD-06 §5 — declared side-effect level of a tool.
enum ToolSideEffect {
  NONE
  INTERNAL
  EXTERNAL

  @@map("tool_side_effect")
}

enum ToolExecutionStatus {
  SUCCEEDED
  FAILED
  DENIED
  AWAITING_APPROVAL

  @@map("tool_execution_status")
}

enum KnowledgeDocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED

  @@map("knowledge_document_status")
}

enum IntegrationCategory {
  MESSAGING
  VOICE
  CALENDAR
  EMAIL
  CRM

  @@map("integration_category")
}

/// SDD-08 §3 — integration lifecycle.
enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  HEALTHY
  DEGRADED

  @@map("integration_status")
}

enum ActorType {
  USER
  AGENT
  SYSTEM
  INTEGRATION

  @@map("actor_type")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED

  @@map("audit_outcome")
}

enum CustomFieldEntity {
  CONTACT
  LEAD
  ESTIMATE
  APPOINTMENT

  @@map("custom_field_entity")
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
  MULTI_SELECT
  CURRENCY

  @@map("custom_field_type")
}

// ---------------------------------------------------------------------------
// Tenancy and identity
// ---------------------------------------------------------------------------

/// SDD-03 §1 — the security and billing boundary.
model Tenant {
  id        String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  /// Vertical template key, e.g. "remodeling" (SDD-03 §6).
  vertical  String       @default("generic-local-business")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// SDD-05 §8 — deletion is a lifecycle operation, not a hard DELETE.
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(6)

  members                TenantUser[]
  businessProfile        BusinessProfile?
  locations              Location[]
  contacts               Contact[]
  leads                  Lead[]
  leadSources            LeadSource[]
  conversations          Conversation[]
  messages               Message[]
  calls                  Call[]
  appointments           Appointment[]
  estimates              Estimate[]
  workflows              Workflow[]
  workflowRuns           WorkflowRun[]
  workflowStepRuns       WorkflowStepRun[]
  agents                 Agent[]
  agentRuns              AgentRun[]
  toolExecutions         ToolExecution[]
  knowledgeDocuments     KnowledgeDocument[]
  knowledgeChunks        KnowledgeChunk[]
  integrations           Integration[]
  events                 Event[]
  auditLogs              AuditLog[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]

  @@index([status])
  @@map("tenants")
}

/// SDD-03 §1 — a human identity. Global, not tenant-scoped: one person may
/// belong to several tenants (FR-002). Tenant-scoped access to people goes
/// through TenantUser, which is RLS-protected.
model User {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String     @unique
  name         String?
  /// Argon2/bcrypt digest. Never a plaintext or reversible secret (SDD-09 §7).
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  memberships          TenantUser[]
  assignedLeads        Lead[]            @relation("LeadAssignee")
  assignedConversations Conversation[]   @relation("ConversationAssignee")
  assignedAppointments Appointment[]     @relation("AppointmentAssignee")

  @@map("users")
}

/// SDD-03 §1 — membership connecting a user to a tenant and role.
model TenantUser {
  id        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      TenantRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, role])
  @@index([userId])
  @@map("tenant_users")
}

// ---------------------------------------------------------------------------
// Business configuration
// ---------------------------------------------------------------------------

/// FR-003. Genuinely schema-flexible settings are JSONB (SDD-04 §7); stable
/// relational concepts such as locations stay in their own tables.
model BusinessProfile {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String  @unique @map("tenant_id") @db.Uuid
  legalName    String? @map("legal_name")
  displayName  String  @map("display_name")
  phone        String?
  email        String?
  website      String?
  description  String?
  timezone     String  @default("America/New_York")
  locale       String  @default("en-US")
  currency     String  @default("USD")
  /// Weekly availability rules (VOS-044).
  businessHours          Json @default("{}") @map("business_hours")
  /// Preferred channels, quiet hours, opt-out handling.
  communicationPreferences Json @default("{}") @map("communication_preferences")
  /// Inputs the qualification agent must collect (VOS-101).
  qualificationRules     Json @default("{}") @map("qualification_rules")
  /// Lead time, duration, buffers used when offering slots (VOS-090).
  bookingRules           Json @default("{}") @map("booking_rules")
  /// Tenant-aware model/provider selection (SDD-06 §9).
  aiConfiguration        Json @default("{}") @map("ai_configuration")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

/// SDD-03 §1 — physical/service location.
model Location {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  addressLine1  String?  @map("address_line1")
  addressLine2  String?  @map("address_line2")
  city          String?
  region        String?
  postalCode    String?  @map("postal_code")
  country       String   @default("US")
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  timezone      String?
  isPrimary     Boolean  @default(false) @map("is_primary")
  /// Service radius in miles; the coarse form of a service area (VOS-043).
  serviceRadiusMiles Int? @map("service_radius_miles")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([tenantId, isPrimary])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

/// SDD-03 §1 — a person or organization interacting with the business.
model Contact {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  email     String?
  /// E.164 normalized. Inbound webhooks resolve contacts on this column, which
  /// is why contacts(tenant_id, phone) is indexed (SDD-04 §6).
  phone     String?
  company   String?
  address   Json?
  tags      String[] @default([])
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads         Lead[]
  conversations Conversation[]
  calls         Call[]
  appointments  Appointment[]
  estimates     Estimate[]

  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, createdAt])
  @@map("contacts")
}

/// VOS-052 — tenant-owned catalog so a vertical template can seed its own set
/// without a platform migration.
model LeadSource {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  label     String
  category  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenantId, key])
  @@map("lead_sources")
}

/// SDD-03 §1 — a sales opportunity associated with a contact.
model Lead {
  id             String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  contactId      String     @map("contact_id") @db.Uuid
  status         LeadStatus @default(NEW)
  sourceId       String?    @map("source_id") @db.Uuid
  /// Requested service. Free text until the service catalog lands (VOS-042).
  service        String?
  assignedUserId String?    @map("assigned_user_id") @db.Uuid
  title          String?
  description    String?
  estimatedValue Decimal?   @map("estimated_value") @db.Decimal(12, 2)
  /// Structured answers collected by the qualification toolset (VOS-101).
  qualification  Json       @default("{}")
  lastContactedAt DateTime? @map("last_contacted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  /// Optimistic concurrency: AI and humans can touch the same lead (SDD-04 §4).
  version   Int       @default(0)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact       Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  source        LeadSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  assignedUser  User?          @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  calls         Call[]
  appointments  Appointment[]
  estimates     Estimate[]
  agentRuns     AgentRun[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, contactId])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Conversations
// ---------------------------------------------------------------------------

/// FR-006 — channel-independent interaction thread.
model Conversation {
  id             String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  contactId      String             @map("contact_id") @db.Uuid
  leadId         String?            @map("lead_id") @db.Uuid
  channel        Channel
  status         ConversationStatus @default(OPEN)
  subject        String?
  assignedUserId String?            @map("assigned_user_id") @db.Uuid
  /// Provider-side thread identifier, used to attach inbound webhooks.
  externalId     String?            @map("external_id")
  lastMessageAt  DateTime?          @map("last_message_at") @db.Timestamptz(6)
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedUser User?      @relation("ConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages     Message[]
  calls        Call[]
  agentRuns    AgentRun[]

  @@unique([tenantId, channel, externalId])
  @@index([tenantId, updatedAt])
  @@index([tenantId, status])
  @@index([tenantId, contactId])
  @@map("conversations")
}

/// FR-007 — direction, channel, status, timestamps, provider metadata.
model Message {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  direction      MessageDirection
  channel        Channel
  status         MessageStatus    @default(QUEUED)
  body           String
  fromAddress    String?          @map("from_address")
  toAddress      String?          @map("to_address")
  provider       String?
  /// Provider message id. Combined with tenant+provider this is the natural
  /// dedup key for webhook ingestion (SDD-08 §5).
  providerMessageId String?       @map("provider_message_id")
  /// Set when an outbound message was produced by an agent (SDD-10 §6).
  agentRunId     String?          @map("agent_run_id") @db.Uuid
  sentAt         DateTime?        @map("sent_at") @db.Timestamptz(6)
  deliveredAt    DateTime?        @map("delivered_at") @db.Timestamptz(6)
  failedAt       DateTime?        @map("failed_at") @db.Timestamptz(6)
  failureReason  String?          @map("failure_reason")
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@unique([tenantId, provider, providerMessageId])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, status])
  @@map("messages")
}

/// SDD-03 §1 — telephony interaction and its metadata/transcript reference.
model Call {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  contactId      String?       @map("contact_id") @db.Uuid
  leadId         String?       @map("lead_id") @db.Uuid
  conversationId String?       @map("conversation_id") @db.Uuid
  direction      CallDirection
  status         CallStatus
  provider       String?
  providerCallId String?       @map("provider_call_id")
  fromNumber     String?       @map("from_number")
  toNumber       String?       @map("to_number")
  startedAt      DateTime?     @map("started_at") @db.Timestamptz(6)
  answeredAt     DateTime?     @map("answered_at") @db.Timestamptz(6)
  endedAt        DateTime?     @map("ended_at") @db.Timestamptz(6)
  durationSeconds Int?         @map("duration_seconds")
  /// Reference only. Recordings and transcripts live in object storage, not
  /// in the primary database (SDD-09 §8).
  recordingRef   String?       @map("recording_ref")
  transcriptRef  String?       @map("transcript_ref")
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([tenantId, provider, providerCallId])
  @@index([tenantId, status, startedAt])
  @@index([tenantId, contactId])
  @@map("calls")
}

// ---------------------------------------------------------------------------
// Appointments and estimates
// ---------------------------------------------------------------------------

/// FR-009 — created and cancelled through the calendar provider abstraction.
model Appointment {
  id             String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  contactId      String            @map("contact_id") @db.Uuid
  leadId         String?           @map("lead_id") @db.Uuid
  locationId     String?           @map("location_id") @db.Uuid
  assignedUserId String?           @map("assigned_user_id") @db.Uuid
  status         AppointmentStatus @default(SCHEDULED)
  title          String
  description    String?
  startsAt       DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime          @map("ends_at") @db.Timestamptz(6)
  timezone       String
  provider       String?
  providerEventId String?          @map("provider_event_id")
  cancelledAt    DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?       @map("cancellation_reason")
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?           @map("created_by") @db.Uuid

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  location     Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedUser User?     @relation("AppointmentAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, provider, providerEventId])
  @@index([tenantId, startsAt])
  @@index([tenantId, status, startsAt])
  @@map("appointments")
}

/// FR-010 — creation, sending, status, and follow-up state.
model Estimate {
  id        String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  leadId    String         @map("lead_id") @db.Uuid
  contactId String         @map("contact_id") @db.Uuid
  /// Human-facing reference, unique per tenant. Not a global sequence, so it
  /// leaks no cross-tenant volume information (SDD-04 §5).
  number    String
  status    EstimateStatus @default(DRAFT)
  currency  String         @default("USD")
  subtotal  Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount Decimal        @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total     Decimal        @default(0) @db.Decimal(12, 2)
  lineItems Json           @default("[]") @map("line_items")
  notes     String?
  validUntil DateTime?     @map("valid_until") @db.Timestamptz(6)
  sentAt    DateTime?      @map("sent_at") @db.Timestamptz(6)
  viewedAt  DateTime?      @map("viewed_at") @db.Timestamptz(6)
  respondedAt DateTime?    @map("responded_at") @db.Timestamptz(6)
  /// Follow-up state driving VOS-112.
  followUpCount   Int       @default(0) @map("follow_up_count")
  lastFollowUpAt  DateTime? @map("last_follow_up_at") @db.Timestamptz(6)
  nextFollowUpAt  DateTime? @map("next_follow_up_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  /// Totals are a high-impact field (SDD-09 §6); guard concurrent edits.
  version   Int       @default(0)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, nextFollowUpAt])
  @@map("estimates")
}

// ---------------------------------------------------------------------------
// Workflow engine (ADR-007)
// ---------------------------------------------------------------------------

/// SDD-07 §2 / §10 — a published version is immutable; reconfiguring creates a
/// new row with an incremented version.
model Workflow {
  id          String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  key         String
  version     Int            @default(1)
  name        String
  description String?
  /// Event name that starts this workflow, e.g. "call.missed" (SDD-07 §3).
  trigger     String
  status      WorkflowStatus @default(DRAFT)
  /// Ordered step list. Declarative by decision (ADR-007), so that adding a
  /// workflow is configuration rather than branching business code.
  definition  Json           @default("{}")
  /// Gate evaluated before a run is created.
  conditions  Json           @default("[]")
  /// SDD-07 §7 — max attempts, backoff, retryable vs terminal errors.
  retryPolicy Json           @default("{}") @map("retry_policy")
  /// SDD-07 §8 — retry | skip | stop | escalate | human handoff.
  failurePolicy Json         @default("{}") @map("failure_policy")
  publishedAt DateTime?      @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   WorkflowRun[]

  @@unique([tenantId, key, version])
  @@index([tenantId, trigger, status])
  @@map("workflows")
}

/// SDD-07 §5 — one execution instance.
model WorkflowRun {
  id           String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  workflowId   String            @map("workflow_id") @db.Uuid
  /// Pinned at creation: an in-flight run keeps executing the version it
  /// started with (SDD-07 §10).
  workflowVersion Int            @map("workflow_version")
  triggerEvent String            @map("trigger_event")
  triggerEventId String?         @map("trigger_event_id") @db.Uuid
  status       WorkflowRunStatus @default(PENDING)
  /// Run-scoped variables available to conditions and step inputs.
  context      Json              @default("{}")
  /// SDD-10 §6 — ties call -> event -> workflow -> agent -> tool -> message.
  correlationId String?          @map("correlation_id") @db.Uuid
  /// SDD-07 §6 — prevents one event from starting the same run twice.
  idempotencyKey String?         @map("idempotency_key")
  currentStepId String?          @map("current_step_id")
  attempt      Int               @default(0)
  scheduledFor DateTime?         @map("scheduled_for") @db.Timestamptz(6)
  startedAt    DateTime?         @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime?         @map("completed_at") @db.Timestamptz(6)
  failedAt     DateTime?         @map("failed_at") @db.Timestamptz(6)
  error        String?
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow  Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  event     Event?            @relation(fields: [triggerEventId], references: [id], onDelete: SetNull)
  stepRuns  WorkflowStepRun[]
  agentRuns AgentRun[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, scheduledFor])
  @@index([tenantId, workflowId, createdAt])
  @@index([correlationId])
  @@map("workflow_runs")
}

/// SDD-07 §5 — execution state for an individual step.
model WorkflowStepRun {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  workflowRunId String           @map("workflow_run_id") @db.Uuid
  /// Step identifier within the workflow definition.
  stepId        String           @map("step_id")
  stepIndex     Int              @map("step_index")
  stepType      WorkflowStepType @map("step_type")
  status        StepRunStatus    @default(PENDING)
  attempt       Int              @default(0)
  maxAttempts   Int              @default(3) @map("max_attempts")
  input         Json             @default("{}")
  output        Json?
  error         String?
  /// SDD-07 §6 — tenant + run + step + target. The unique constraint below is
  /// what actually stops a retried worker from sending the same SMS twice.
  idempotencyKey String?         @map("idempotency_key")
  scheduledFor  DateTime?        @map("scheduled_for") @db.Timestamptz(6)
  startedAt     DateTime?        @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz(6)
  durationMs    Int?             @map("duration_ms")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, workflowRunId, stepIndex])
  @@index([tenantId, status, scheduledFor])
  @@map("workflow_step_runs")
}

// ---------------------------------------------------------------------------
// AI (ADR-006, SDD-06)
// ---------------------------------------------------------------------------

/// SDD-06 §3 — an AI capability definition. Versioned like workflows so a run
/// can always be replayed against the configuration that produced it.
model Agent {
  id           String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  key          String
  version      Int         @default(1)
  name         String
  status       AgentStatus @default(DRAFT)
  /// System instructions. SDD-06 §9 — prompts are versioned artifacts.
  instructions String
  promptVersion String     @map("prompt_version")
  /// Provider/model/temperature. Provider SDK types never reach the domain
  /// layer (ADR-006 §Rule), so this stays opaque configuration here.
  modelConfiguration Json  @default("{}") @map("model_configuration")
  /// Tool names this agent may call. Authorization is still enforced per call
  /// (SDD-06 §5); this list is the allow-list, not the permission.
  allowedTools String[]    @default([]) @map("allowed_tools")
  knowledgeStrategy Json   @default("{}") @map("knowledge_strategy")
  guardrails   Json        @default("{}")
  handoffPolicy Json       @default("{}") @map("handoff_policy")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AgentRun[]

  @@unique([tenantId, key, version])
  @@index([tenantId, status])
  @@map("agents")
}

/// SDD-06 §9 / SDD-10 §3 — one execution, with the telemetry needed for
/// debugging and cost analysis.
model AgentRun {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  agentId        String         @map("agent_id") @db.Uuid
  agentVersion   Int            @map("agent_version")
  promptVersion  String         @map("prompt_version")
  conversationId String?        @map("conversation_id") @db.Uuid
  leadId         String?        @map("lead_id") @db.Uuid
  workflowRunId  String?        @map("workflow_run_id") @db.Uuid
  status         AgentRunStatus @default(RUNNING)
  provider       String
  model          String
  inputTokens    Int?           @map("input_tokens")
  outputTokens   Int?           @map("output_tokens")
  /// Nullable: not every provider reports cost.
  costAmount     Decimal?       @map("cost_amount") @db.Decimal(12, 6)
  costCurrency   String?        @map("cost_currency")
  latencyMs      Int?           @map("latency_ms")
  toolCount      Int            @default(0) @map("tool_count")
  failureReason  String?        @map("failure_reason")
  handoff        Boolean        @default(false)
  handoffReason  String?        @map("handoff_reason")
  correlationId  String?        @map("correlation_id") @db.Uuid
  startedAt      DateTime       @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent          Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation   Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  workflowRun    WorkflowRun?    @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  toolExecutions ToolExecution[]
  messages       Message[]

  @@index([tenantId, status, startedAt])
  @@index([tenantId, agentId, startedAt])
  @@index([correlationId])
  @@map("agent_runs")
}

/// SDD-06 §5 — one invocation of an agent tool, with its authorization outcome.
model ToolExecution {
  id         String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  agentRunId String              @map("agent_run_id") @db.Uuid
  toolName   String              @map("tool_name")
  /// Capability required to run it, e.g. "appointment.write" (SDD-09 §3).
  permission String?
  sideEffect ToolSideEffect      @default(NONE) @map("side_effect")
  status     ToolExecutionStatus
  /// Validated against the tool's declared input schema before execution.
  input      Json                @default("{}")
  output     Json?
  error      String?
  /// False when the agent asked for something it was not allowed to do. These
  /// rows are the audit trail for SDD-09 §4.
  authorized Boolean             @default(false)
  approvalRequired Boolean       @default(false) @map("approval_required")
  approvedBy String?             @map("approved_by") @db.Uuid
  approvedAt DateTime?           @map("approved_at") @db.Timestamptz(6)
  /// Stops a retried agent turn from repeating an external side effect.
  idempotencyKey String?         @map("idempotency_key")
  latencyMs  Int?                @map("latency_ms")
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, agentRunId])
  @@index([tenantId, toolName, createdAt])
  @@map("tool_executions")
}

// ---------------------------------------------------------------------------
// Knowledge (ADR-004)
// ---------------------------------------------------------------------------

/// SDD-03 §1 — a tenant-owned source document.
model KnowledgeDocument {
  id         String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String                  @map("tenant_id") @db.Uuid
  title      String
  sourceType String                  @map("source_type")
  sourceUri  String?                 @map("source_uri")
  /// Lets the embedding pipeline skip unchanged documents (VOS-076).
  contentHash String?                @map("content_hash")
  status     KnowledgeDocumentStatus @default(PENDING)
  version    Int                     @default(1)
  metadata   Json                    @default("{}")
  processedAt DateTime?              @map("processed_at") @db.Timestamptz(6)
  error      String?
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?               @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([tenantId, status])
  @@index([tenantId, contentHash])
  @@map("knowledge_documents")
}

/// SDD-04 §8 — an embedded semantic chunk.
///
/// `embedding` is a pgvector column. Prisma has no native mapping for it, so
/// it is declared Unsupported and read/written through the raw helpers in
/// src/vector.ts. Its dimension is provider/model configuration (SDD-04 §2)
/// and is asserted against EMBEDDING_DIMENSIONS at startup.
model KnowledgeChunk {
  id         String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  documentId String  @map("document_id") @db.Uuid
  content    String
  embedding  Unsupported("vector(1536)")?
  chunkIndex Int     @map("chunk_index")
  tokenCount Int?    @map("token_count")
  metadata   Json    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, documentId, chunkIndex])
  @@index([tenantId, documentId])
  @@map("knowledge_chunks")
}

// ---------------------------------------------------------------------------
// Integrations, events, audit
// ---------------------------------------------------------------------------

/// SDD-03 §1 — connection metadata for an external provider.
model Integration {
  id       String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId String              @map("tenant_id") @db.Uuid
  provider String
  category IntegrationCategory
  status   IntegrationStatus   @default(DISCONNECTED)
  /// Pointer into the secret manager. Credentials themselves are NEVER stored
  /// in this database (SDD-08 §4, SDD-09 §7).
  credentialsRef String?       @map("credentials_ref")
  /// Non-secret provider settings only.
  configuration  Json          @default("{}")
  externalAccountId String?    @map("external_account_id")
  healthCheckedAt DateTime?    @map("health_checked_at") @db.Timestamptz(6)
  healthError     String?      @map("health_error")
  connectedAt     DateTime?    @map("connected_at") @db.Timestamptz(6)
  disconnectedAt  DateTime?    @map("disconnected_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalAccountId])
  @@index([tenantId, category, status])
  @@map("integrations")
}

/// ADR-008 — durable internal event. `publishedAt` makes this an outbox: the
/// row is written in the same transaction as the state change, and dispatched
/// to the queue afterwards (SDD-04 §9).
model Event {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// Event name, e.g. "lead.created".
  name          String
  /// Schema version of `payload` (VOS-080).
  version       Int      @default(1)
  aggregateType String?  @map("aggregate_type")
  aggregateId   String?  @map("aggregate_id") @db.Uuid
  payload       Json     @default("{}")
  correlationId String?  @map("correlation_id") @db.Uuid
  causationId   String?  @map("causation_id") @db.Uuid
  /// Deduplicates at-least-once delivery from providers and retries.
  idempotencyKey String? @map("idempotency_key")
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowRuns WorkflowRun[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, name, occurredAt])
  @@index([tenantId, aggregateType, aggregateId])
  /// Outbox drain: unpublished events, oldest first.
  @@index([publishedAt, occurredAt])
  @@index([correlationId])
  @@map("events")
}

/// FR-013 / SDD-09 §10 — security and operations record.
model AuditLog {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  actorType    ActorType    @map("actor_type")
  /// User id, agent run id, or integration id depending on actorType.
  actorId      String?      @map("actor_id") @db.Uuid
  actorLabel   String?      @map("actor_label")
  action       String
  resourceType String?      @map("resource_type")
  resourceId   String?      @map("resource_id") @db.Uuid
  outcome      AuditOutcome @default(SUCCESS)
  /// Before/after diff. Must be scrubbed of secrets and unnecessary PII
  /// before it reaches this column (SDD-09 §8).
  changes      Json?
  ipAddress    String?      @map("ip_address") @db.Inet
  userAgent    String?      @map("user_agent")
  correlationId String?     @map("correlation_id") @db.Uuid
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, actorType, actorId])
  @@index([correlationId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Custom fields (SDD-03 §5)
//
// Vertical-specific attributes live here rather than as columns on core
// entities, so a new vertical is configuration rather than a migration.
// ---------------------------------------------------------------------------

model CustomFieldDefinition {
  id           String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  entityType   CustomFieldEntity @map("entity_type")
  key          String
  label        String
  fieldType    CustomFieldType   @map("field_type")
  /// Allowed values for SELECT/MULTI_SELECT.
  options      Json              @default("[]")
  isRequired   Boolean           @default(false) @map("is_required")
  isActive     Boolean           @default(true) @map("is_active")
  displayOrder Int               @default(0) @map("display_order")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values CustomFieldValue[]

  @@unique([tenantId, entityType, key])
  @@index([tenantId, entityType, isActive])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id           String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  definitionId String            @map("definition_id") @db.Uuid
  entityType   CustomFieldEntity @map("entity_type")
  /// Polymorphic by design: no FK, because the target table varies. The
  /// (tenant_id, entity_type, entity_id) index is how values are loaded.
  entityId     String            @map("entity_id") @db.Uuid
  value        Json?
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, definitionId, entityId])
  @@index([tenantId, entityType, entityId])
  @@map("custom_field_values")
}
