# ---------------------------------------------------------------------------
# Vautrin OS — local development environment
#
# Copy to `.env` and adjust. Never commit `.env` (SDD-09 §7).
# Values below match infra/docker-compose.yml defaults.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
# Host port 5435: 5432/5433 are commonly taken by local Postgres installs.
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=vautrin
POSTGRES_SUPERUSER=vautrin
POSTGRES_SUPERUSER_PASSWORD=vautrin_local_dev

# Runtime connection. Uses the least-privileged application role, which is
# subject to Row Level Security (ADR-005). The API and worker use THIS url.
DATABASE_URL="postgresql://vautrin_app:vautrin_local_dev@localhost:5435/vautrin?schema=public"

# Migration connection. Owns the schema and runs `prisma migrate`.
# Never used to serve application traffic.
DATABASE_MIGRATION_URL="postgresql://vautrin_migrator:vautrin_local_dev@localhost:5435/vautrin?schema=public"

# --- Redis (ADR-009) -------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Embeddings (SDD-04 §2) ------------------------------------------------
# Dimensions are provider/model configuration. This value MUST match the
# `vector(N)` column declared in the knowledge_chunks migration; the database
# package asserts this at startup.
EMBEDDING_DIMENSIONS=1536

# --- Applications ---------------------------------------------------------
NODE_ENV=development

# apps/api
API_PORT=3000
API_GLOBAL_PREFIX=api

LOG_LEVEL=debug

# --- Full-stack docker compose -------------------------------------------
# Only used by the root docker-compose.yml, which runs the apps in containers.
# Inside that stack the services reach each other by name (postgres, redis),
# so DATABASE_URL/REDIS_URL above apply to host-side development only.

# Host ports the containerised apps are published on.
API_HOST_PORT=3000
# 3001 is commonly taken by other local services.
WEB_HOST_PORT=3002

# Image tag. `pnpm docker:build` sets this to the commit SHA (SDD-12 §9).
VAUTRIN_IMAGE_TAG=dev

# --- Authentication (ADR-013) ---------------------------------------------
# Signing key for access tokens. The value below is PUBLISHED and therefore
# worthless as a secret — the application refuses to start with it when
# NODE_ENV=production. Generate a real one with:  openssl rand -base64 48
JWT_SECRET=dev-only-insecure-jwt-secret-do-not-use-in-production-0000
